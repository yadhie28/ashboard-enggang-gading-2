<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.soedarso.engganggading.autosync</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rusmulyadiiskandar/.gemini/antigravity-ide/scratch/dashboard-enggang-gading-2/auto_sync.sh</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/rusmulyadiiskandar/.gemini/antigravity-ide/scratch/dashboard-enggang-gading-2</string>
    
    <!-- Jalankan otomatis saat login / startup untuk catch-up sensus jika laptop baru menyala -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- Jadwal penarikan data 3 kali sehari sesuai jadwal operan jaga -->
    <!-- SHIFT PAGI: Dijalankan jam 06:45 WIB agar WA terkirim sebelum 07:02 WIB -->
    <!-- (Download sheet ~5-10 menit + build data ~2-3 menit = selesai ~07:00) -->
    <!-- Perubahan dari 07:00 → 06:45 untuk memastikan ketepatan waktu laporan -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>45</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    
    <key>StandardOutPath</key>
    <string>/Users/rusmulyadiiskandar/.gemini/antigravity-ide/scratch/dashboard-enggang-gading-2/auto_sync_launchd.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/rusmulyadiiskandar/.gemini/antigravity-ide/scratch/dashboard-enggang-gading-2/auto_sync_launchd.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/rusmulyadiiskandar</string>
    </dict>
</dict>
</plist>
